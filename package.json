{
  "name": "sidetrack",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "predev": "pnpm db:migrate && SIDETRACK_SEED=true pnpm db:seed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "vitest run --config vitest.eval.config.ts",
    "test:mutation": "stryker run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/core/migrate.ts",
    "backup:open": "tsx scripts/open-backup.ts",
    "db:seed": "ALLOW_SIGNUP=true tsx scripts/seed.ts",
    "mailpit": "docker compose -f docker-compose.dev.yml up"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@posthog/nextjs-config": "^1.9.52",
    "@tanstack/react-virtual": "^3.14.26",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.7",
    "better-sqlite3": "^12.11.1",
    "chrono-node": "^2.10.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.12.1",
    "fractional-indexing": "^3.2.0",
    "frimousse": "^0.3.0",
    "ical.js": "^2.2.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.16.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "nanoid": "^5.1.16",
    "next": "16.4.6",
    "nodemailer": "^10.1.4",
    "posthog-js": "^1.382.0",
    "posthog-node": "^5.36.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "geist": "1.9.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
