{
  "name": "sidetrack",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "predev": "pnpm db:migrate && SIDETRACK_SEED=true pnpm db:seed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/core/migrate.ts",
    "db:seed": "ALLOW_SIGNUP=true tsx scripts/seed.ts",
    "mailpit": "docker compose -f docker-compose.dev.yml up"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@posthog/nextjs-config": "^1.9.52",
    "better-auth": "1.6.11",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fractional-indexing": "^3.2.0",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "nodemailer": "^8.0.10",
    "posthog-js": "^1.382.0",
    "posthog-node": "^5.36.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
