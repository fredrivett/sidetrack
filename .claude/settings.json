{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm lint --quiet"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -q '^### ' LEARNINGS.md && echo '⚠ Untriaged LEARNINGS.md drafts — run triage (see top of LEARNINGS.md)' || true"
          }
        ]
      }
    ]
  }
}
