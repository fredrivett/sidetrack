{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm lint --quiet 1>&2 || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./node_modules/.bin/tsx scripts/changelog-approval.ts claude-post"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -q '^### ' LEARNINGS.md && echo '⚠ Untriaged LEARNINGS.md drafts — run triage (see top of LEARNINGS.md)' || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./node_modules/.bin/tsx scripts/changelog-approval.ts claude-pre"
          }
        ]
      }
    ]
  }
}
